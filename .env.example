# ルート .env のサンプル（docker-compose / バックエンドが参照する環境変数）。
# 実値はコミットせず、各自ローカルの `.env` に設定する（`.env` は .gitignore 済み）。
#
# ⚠️ 旧クレデンシャルは Git 履歴に残り公開済みのため「漏洩」扱い。
#    以下は必ず「新しくローテーションした値」を設定すること。

# --- Google OAuth（Google Cloud Console で発行・再生成） ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- フロントエンドの URL（CORS / リダイレクト用） ---
FRONTEND_URL=http://localhost:5173

# --- DB 接続（未設定なら docker-compose のローカル db サービスを使用） ---
# 本番/別DBに繋ぐ場合のみ設定する。
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/beatseeker
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your-db-password

# --- Web Push (VAPID) 鍵。tools/generate_vapid.js で再生成した値 ---
# 秘密鍵は必ず環境変数で渡す。公開鍵を差し替えたらフロントエンド側も更新すること。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
