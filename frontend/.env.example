# beat-seeker フロントエンド用環境変数のサンプル。
# 値を上書きしたい場合のみ `.env` にコピーして設定する。
# 未設定でも従来のハードコード値で動作する。

# API サーバのベース URL（本番デプロイ時に上書き）
# VITE_API_BASE=http://localhost:8080

# Web Push 通知で使用する VAPID 公開鍵（base64url）。
# 未設定時はハードコード済みのデフォルト鍵を利用。
# VITE_VAPID_PUBLIC_KEY=

# 管理者として扱うユーザーの DB 主キー ID（未設定時: 18）
# VITE_ADMIN_USER_ID=18

# 管理者として扱う IIDX ID（未設定時: 5787-1145）
# VITE_ADMIN_IIDX_ID=5787-1145

# Android アプリ (APK) の配布 URL。Android のブラウザで開いたときだけ
# 取り込みモーダルにダウンロードリンクを出す。
# 未設定時は GitHub Releases の固定タグ android-latest を指す
# （.github/workflows/android-release-apk.yml が同名アセットを上書きする）。
# 空文字を設定するとダウンロード導線自体を出さない。
# VITE_ANDROID_APK_URL=https://github.com/ohno-k/beat-seeker/releases/download/android-latest/beat-seeker.apk
